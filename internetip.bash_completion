#!/bin/bash
# Bash completion for internetip

_internetip() {
  local -- cur prev
  COMPREPLY=()
  cur=${COMP_WORDS[COMP_CWORD]}
  prev=${COMP_WORDS[COMP_CWORD-1]}

  # Subcommand-style verbs (first non-option argument)
  local -- commands='install update uninstall seturl showurl unseturl'

  # Short and long options
  local -- opts='-s -c -v -q -h -V --call-url --verbose --quiet --help --version'

  # Long-option equivalents of the subcommands
  local -- long_cmds='--install --update --uninstall --set-url --show-url --unset-url'

  # seturl accepts a URL argument; no meaningful completion for URLs
  case $prev in
    seturl|--set-url) return 0 ;;
  esac

  if [[ $cur == -* ]]; then
    mapfile -t COMPREPLY < <(compgen -W "$opts $long_cmds" -- "$cur")
  elif ((COMP_CWORD == 1)); then
    mapfile -t COMPREPLY < <(compgen -W "$commands" -- "$cur")
  fi
}

complete -F _internetip internetip
#fin
