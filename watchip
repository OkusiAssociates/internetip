#!/usr/bin/env bash
# Monitor and log public IP address changes

watch_ip() {
  # Lazy-load internetip dependency — avoids polluting the caller's namespace
  # when watchip is sourced. Script mode also sources below the fence so
  # startup failures surface early; this path only fires for sourced callers.
  declare -F get_internet_ip &>/dev/null || source internetip 2>/dev/null || return 18
  local -- ipfile=${1:-/tmp/internetip.txt}
  local -- oldip curip

  # First run: fetch once, store, return
  if [[ ! -f $ipfile ]]; then
    curip=$(get_internet_ip) || return 1
    echo "$curip" > "$ipfile"
    echo "initial:$curip"
    return 0
  fi

  # Subsequent runs: read stored, fetch current, compare
  oldip=$(<"$ipfile")
  curip=$(get_internet_ip) || return 1

  if [[ $oldip != "$curip" ]]; then
    echo "$curip" > "$ipfile"
    echo "changed:$oldip:$curip"
  else
    echo "unchanged:$curip"
  fi
}

# --- source fence ---
[[ ${BASH_SOURCE[0]} == "$0" ]] || { declare -fx watch_ip; return 0; }

# --- script mode only below ---
set -euo pipefail
shopt -s inherit_errexit

# Load internetip for get_internet_ip in script mode (sourced callers get the
# lazy load inside watch_ip itself — see W1/W1b resolution).
source internetip || {
  >&2 printf '%s: ✗ %s\n' "$(basename -- "$0")" \
      'Command internetip not found; check installation'
  exit 18
}

declare -r VERSION=2.1.0
#shellcheck disable=SC2155  # realpath failure would be fatal; downstream empty-name checks would surface it
declare -r SCRIPT_PATH=$(realpath -e -- "$0")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

declare -- IPFILE=${IPFILE:-/tmp/"$SCRIPT_NAME".txt}

# LOGFILE with fallback: /var/log if writable, else ~/
declare -- LOGFILE=${LOGFILE:-}
if [[ -z $LOGFILE ]]; then
  LOGFILE=/var/log/"$SCRIPT_NAME".log
  if ! touch "$LOGFILE" 2>/dev/null; then
    LOGFILE="$HOME"/."$SCRIPT_NAME".log
  fi
fi

log_msg() {
  printf '%(%F %T)T %s: %s\n' -1 "$USER" "$*" >> "$LOGFILE" ||:
}

log_sys() { ((EUID)) || logger -t "$SCRIPT_NAME" -p local0.notice "$@"; log_msg "$@"; echo "$@"; }
log_err() { ((EUID)) || logger -t "$SCRIPT_NAME" -p local0.err "ERROR: $*"; log_msg "ERROR: $*"; >&2 echo "$@"; }
# Operational death — logs to syslog/logfile. Use for runtime failures worth recording.
log_die() { log_err "${@:2}"; exit "${1:-1}"; }
# Plain death — stderr only, no logfile write. Use for argparse/usage errors
# so user typos don't pollute the operational log.
die() { >&2 printf '%s: ✗ %s\n' "$SCRIPT_NAME" "${*:2}"; exit "${1:-1}"; }

do_log() {
  if [[ -f $LOGFILE && -r $LOGFILE ]]; then
    cat "$LOGFILE"
  else
    >&2 printf '%s: %s\n' "$SCRIPT_NAME" "Cannot read log ${LOGFILE@Q}"
    return 1
  fi
}

show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Monitor and log public IP address changes

Usage: $SCRIPT_NAME [options]
       source $SCRIPT_NAME  # Load watch_ip function

Options:
  -l, --log     Display log file contents
  -q, --quiet   Suppress output when IP unchanged
  -h, --help    Display this help
  -V, --version Display version

Exported Functions (when sourced):
  watch_ip [file]   Compare stored vs current IP
                    Returns: "initial:ip" (first run, no IPFILE yet),
                             "changed:old:new", or "unchanged:ip"

Behavior:
  - Logs to syslog when run as root (local0.notice)
  - Logs all activity to LOGFILE
  - Calls internetip -s on change to notify remote server
  - Stores current IP in IPFILE

Environment:
  LOGFILE       Log file (default: /var/log/watchip.log,
                falls back to ~/.watchip.log if not writable)
  IPFILE        IP tracking file (default: /tmp/$SCRIPT_NAME.txt)

Exit Codes:
  0   Success (IP checked)
  1   Error fetching or processing IP
  22  Invalid option (EINVAL)

Examples:
  $SCRIPT_NAME                   # Check for IP change
  $SCRIPT_NAME -q                # Quiet mode (for cron)

  # Cron job (check every 5 minutes)
  */5 * * * * /usr/local/bin/$SCRIPT_NAME -q

  # Sourced mode
  source $SCRIPT_NAME
  result=\$(watch_ip /tmp/myapp_ip.txt)
  [[ \$result == changed:* ]] && echo "IP changed!"
HELP
}

main() {
  local -i quiet=0
  local -- result oldip curip

  # Parse options
  while (($#)); do
    case $1 in
      -h|--help)    show_help; return 0 ;;
      -V|--version) printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"; return 0 ;;
      -l|--log|log) do_log; return $? ;;
      -q|--quiet)   quiet=1 ;;
      -*)           die 22 "Unknown option ${1@Q}. Try: $SCRIPT_NAME --help" ;;
      *)            die 22 "Unexpected argument ${1@Q}" ;;
    esac
    shift
  done

  # Watch for changes
  result=$(watch_ip "$IPFILE") || log_die 23 'Error checking IP'

  if [[ $result == initial:* ]]; then
    # First run: initial:ip
    curip=${result#initial:}
    log_sys "Initial IP ${curip@Q}"
  elif [[ $result == changed:* ]]; then
    # Parse result: changed:oldip:newip
    oldip=${result#changed:}
    curip=${oldip#*:}
    oldip=${oldip%%:*}
    # Store to remote and log
    internetip -s &>/dev/null ||:
    log_sys "IP changed from ${oldip@Q} to ${curip@Q}"
  else
    # unchanged:ip
    curip=${result#unchanged:}
    ((quiet)) || echo "IP unchanged ${curip@Q}"
  fi
}

main "$@"
#fin
