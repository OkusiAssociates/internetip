#!/usr/bin/env bash
# Fetch and validate public internet IP address

# Source valid_ip function
source validip || {
  >&2 printf '%s: ✗ %s\n' "$(basename -- "$0")" 'Command validip not found; check installation'
  # Return when sourced, exit when executed — avoid killing caller shell
  [[ ${BASH_SOURCE[0]} == "$0" ]] && exit 18 || return 18
}

get_internet_ip() {
  local -- ip
  ip=$(curl -4sf --max-time 10 --retry 3 --retry-delay 5 --retry-all-errors 'http://ipecho.net/plain' 2>/dev/null | head -n1)
  valid_ip "$ip" || return 1
  echo "$ip"
}

internetip() { get_internet_ip "$@"; }

# Check if the script is being sourced or executed directly
[[ ${BASH_SOURCE[0]} == "$0" ]] || { declare -fx get_internet_ip internetip; return 0; }

set -euo pipefail
shopt -s inherit_errexit

declare -rx PATH=/usr/local/bin:/usr/bin:/bin

declare -r VERSION=2.3.0
#shellcheck disable=SC2155
declare -r SCRIPT_PATH=$(realpath -e -- "$0")
declare -r SCRIPT_DIR=${SCRIPT_PATH%/*} SCRIPT_NAME=${SCRIPT_PATH##*/}

declare -r GATEWAY_IP_FILE=${GATEWAY_IP_FILE:-/tmp/GatewayIP}
declare -r INTERNETIP_PROFILE=${INTERNETIP_PROFILE:-/etc/profile.d/"$SCRIPT_NAME".sh}

declare -- GATEWAY_IP
GATEWAY_IP=$(head -n 1 "$GATEWAY_IP_FILE" 2>/dev/null ||:)

# Callback URL template (set via --set-url, no default)
: "${INTERNETIP_CALL_URL:=}"

declare -i VERBOSE=1
# Color definitions
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  VERBOSE=0
  declare -r RED='' GREEN='' YELLOW='' CYAN='' NC=''
fi
# Utility functions
_msg() {
  local -- prefix="$SCRIPT_NAME:" msg
  case ${FUNCNAME[1]} in
    info)    prefix+=" $CYAN◉$NC" ;;
    warn)    prefix+=" $YELLOW▲$NC" ;;
    success) prefix+=" $GREEN✓$NC" ;;
    error)   prefix+=" $RED✗$NC" ;;
  esac
  for msg in "$@"; do printf '%s %s\n' "$prefix" "$msg"; done
}
info() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
warn() { >&2 _msg "$@"; }
success() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
error() { >&2 _msg "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

# Expand allowed template variables in URL
# Usage: expanded=$(expand_url_template "$template" "$gateway_ip")
expand_url_template() {
  local -- url=$1
  local -- gateway_ip=${2:-$GATEWAY_IP}

  local -- wifi
  wifi=$(iwgetid -r 2>/dev/null) \
      || wifi=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^yes:' | cut -d: -f2 | head -n1) \
      || wifi=$HOSTNAME
  url="${url//\$WIFI/$wifi}"
  url="${url//WIFI/$wifi}"

  url="${url//\$HOSTNAME/$HOSTNAME}"
  url="${url//HOSTNAME/$HOSTNAME}"
  url="${url//\$GATEWAY_IP/$gateway_ip}"
  url="${url//GATEWAY_IP/$gateway_ip}"
  url="${url//\$SCRIPT_NAME/$SCRIPT_NAME}"
  url="${url//SCRIPT_NAME/$SCRIPT_NAME}"
  url="${url//\$VERSION/$VERSION}"
  url="${url//VERSION/$VERSION}"
  printf '%s' "$url"
}

show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Fetch and display public internet IP address

Usage: $SCRIPT_NAME [command|options]
       source $SCRIPT_NAME  # Load get_internet_ip function

Commands:
  install             Install scripts to /usr/local/bin (requires root)
  update              Git pull and reinstall (requires root)
  uninstall           Remove scripts from /usr/local/bin (requires root)
  seturl [URL]        Configure system-wide callback URL (requires root)
  showurl             Show current callback URL configuration
  unseturl            Remove system-wide URL configuration (requires root)

Options:
  -s, -c, --call-url  Call callback URL after fetching IP
  -v, --verbose       Increase verbosity
  -q, --quiet         Suppress informational output
  -h, --help          Display this help
  -V, --version       Display version

  Long options (--install, --set-url, etc.) are also supported.

Environment:
  INTERNETIP_CALL_URL  Callback URL template for -s option (set via seturl)
                       Currently ${INTERNETIP_CALL_URL@Q}.
                       Template variables: \$HOSTNAME \$GATEWAY_IP \$WIFI \$SCRIPT_NAME \$VERSION
                       (The \$ prefix is optional: HOSTNAME works same as \$HOSTNAME)
  INTERNETIP_PROFILE   Profile file for URL config (def. /etc/profile.d/internetip.sh)
  GATEWAY_IP_FILE      File containing cached IP (def. $GATEWAY_IP_FILE)

Exported Functions (when sourced):
  get_internet_ip   Fetch and validate public IP, returns via stdout
  valid_ip <ip>     Validate IPv4 or IPv6 (auto-dispatched; via validip module)

Notes:
  - Uses ipecho.net to detect public IP
  - Caches result to ${GATEWAY_IP_FILE@Q} when run as root
  - Uses curl with 10-second timeout and retry (3 attempts, 5s delay)

Examples:
  $SCRIPT_NAME                       # Display current public IP
  $SCRIPT_NAME -s                    # Fetch IP and call callback URL
  $SCRIPT_NAME showurl               # Show current URL configuration

  sudo $SCRIPT_NAME install          # Install to /usr/local/bin
  sudo $SCRIPT_NAME update           # Update from git + reinstall
  sudo $SCRIPT_NAME uninstall        # Remove from /usr/local/bin
  sudo $SCRIPT_NAME seturl           # Configure callback URL interactively
  sudo $SCRIPT_NAME seturl='https://example.com?host=HOSTNAME&ip=GATEWAY_IP'
  sudo $SCRIPT_NAME unseturl         # Remove URL configuration

  source $SCRIPT_NAME
  ip=\$(get_internet_ip)             # Use in scripts
  valid_ip "\$ip" && echo "Valid"
HELP
}

internetip_call_url() {
  if [[ -z ${INTERNETIP_CALL_URL:-} ]]; then
    #shellcheck source=/dev/null
    source "$INTERNETIP_PROFILE" 2>/dev/null ||:
    [[ -n ${INTERNETIP_CALL_URL:-} ]] \
        || die 19 'INTERNETIP_CALL_URL not set.' "Run: sudo $SCRIPT_NAME --set-url [url]"
  fi

  local -- url
  url=$(expand_url_template "$INTERNETIP_CALL_URL" "$1")
  info "Calling ${url@Q}"
  curl -sf --max-time 10 --retry 3 --retry-delay 5 --retry-all-errors "$url" >/dev/null \
      || die 23 "Error calling ${url@Q}"
}

do_install() {
  ((EUID == 0)) || die 13 'Install requires root.' "Run: sudo $SCRIPT_NAME --install"

  local -a scripts=(internetip validip watchip)
  local -- script

  for script in "${scripts[@]}"; do
    [[ -x $SCRIPT_DIR/$script ]] || die 3 "Script not found '$SCRIPT_DIR/$script'"
    ln -sf "$SCRIPT_DIR"/"$script" /usr/local/bin/"$script"
    info "Installed: /usr/local/bin/$script -> '$SCRIPT_DIR/$script'"
  done

  # Bash completion
  if [[ -d /etc/bash_completion.d && -f "$SCRIPT_DIR"/internetip.bash_completion ]]; then
    ln -sf "$SCRIPT_DIR/internetip.bash_completion" "/etc/bash_completion.d/internetip"
    info 'Installed: /etc/bash_completion.d/internetip'
  fi

  success 'Installation complete'
}

do_update() {
  ((EUID == 0)) || die 13 'Update requires root.' "Run: sudo $SCRIPT_NAME --update"

  cd "$SCRIPT_DIR" || die 3 "Cannot cd to ${SCRIPT_DIR@Q}"

  [[ -d .git ]] || die 21 "Not a git repository ${SCRIPT_DIR@Q}"

  git pull || die 23 'Git pull failed'
  info 'Updated from git'

  # Reinstall if already installed
  if [[ -L /usr/local/bin/internetip ]]; then
    do_install
  fi
}

do_uninstall() {
  ((EUID == 0)) || die 13 'Uninstall requires root.' "Run: sudo $SCRIPT_NAME --uninstall"

  rm -f /usr/local/bin/{internetip,validip,watchip}
  rm -f /etc/bash_completion.d/internetip

  info 'Uninstalled internetip, validip, watchip from /usr/local/bin'
}

do_set_url() {
  ((EUID == 0)) || die 13 'Requires root.' "Run: sudo $SCRIPT_NAME --set-url"

  local -- url=${1:-}
  local -- current=${INTERNETIP_CALL_URL:-}

  # If no URL provided as argument, prompt interactively
  if [[ -z $url ]]; then
    #shellcheck disable=SC2016  # Intentionally showing literal variable names
    echo 'Enter callback URL template (variables: $HOSTNAME $GATEWAY_IP $WIFI $SCRIPT_NAME $VERSION)'
    [[ -n $current ]] && echo "Current: $current"
    read -r -p '> ' url
    # Use current if user just presses Enter, but require input if none exists
    if [[ -z $url ]]; then
      [[ -n $current ]] || die 19 'No URL provided and no existing URL configured'
      url=$current
    fi
  fi

  # Escape URL for embedding inside single-quoted shell strings.
  # Replaces each ' with '\'' (close quote, literal quote, reopen quote).
  local -- sq_url=${url//\'/\'\\\'\'}

  # Write "$INTERNETIP_PROFILE" (stores template unexpanded)
  cat > "$INTERNETIP_PROFILE" << EOF
# internetip callback URL template - variables expanded at runtime
export INTERNETIP_CALL_URL='$sq_url'
EOF
  chmod 644 "$INTERNETIP_PROFILE"
  info "Written: $INTERNETIP_PROFILE"

  # Write systemd generator (emits KEY=VALUE on stdout for systemd to capture)
  mkdir -p /etc/systemd/system-environment-generators
  cat > /etc/systemd/system-environment-generators/internetip << EOT
#!/usr/bin/env bash
printf '%s\n' 'INTERNETIP_CALL_URL=$sq_url'
EOT
  chmod 755 /etc/systemd/system-environment-generators/internetip
  info 'Written: /etc/systemd/system-environment-generators/internetip'

  systemctl daemon-reload
  info 'Ran: systemctl daemon-reload'

  success 'URL template configured.' "Re-login or run: source $INTERNETIP_PROFILE"
}

do_show_url() {
  local -- template=${INTERNETIP_CALL_URL:-<not set>}
  echo "Template: $template"
  echo "Expanded: $(expand_url_template "$template" '<IP>')"
  if [[ -f "$INTERNETIP_PROFILE" ]]; then
    echo "System:   $(grep -oP "INTERNETIP_CALL_URL='\\K[^']+" "$INTERNETIP_PROFILE" 2>/dev/null || echo '<not configured>')"
  fi
}

do_unset_url() {
  ((EUID == 0)) || die 13 'Requires root.' "Run: sudo $SCRIPT_NAME --unset-url"

  rm -f "$INTERNETIP_PROFILE"
  rm -f /etc/systemd/system-environment-generators/internetip
  systemctl daemon-reload 2>/dev/null ||:

  success 'URL configuration removed'
}

main() {
  local -i call_url=0

  # Parse options
  while (($#)); do
    case $1 in
      install|--install)
        do_install; return 0 ;;
      update|--update)
        do_update; return 0 ;;
      uninstall|--uninstall)
        do_uninstall; return 0 ;;

      seturl=*|--set-url=*)
        do_set_url "${1#*=}"; return 0 ;;
      seturl|--set-url)
        # Check if next arg exists and is not an option
        if [[ -n ${2:-} && $2 != -* ]]; then
          do_set_url "$2"; return 0
        fi
        do_set_url; return 0 ;;
      showurl|--show-url)
        do_show_url; return 0 ;;
      unseturl|--unset-url)
        do_unset_url; return 0 ;;

      -s|-c|--call-url)
        call_url=1 ;;

      -v|--verbose) VERBOSE+=1 ;;
      -q|--quiet)   VERBOSE=0 ;;

      -V|--version) echo "$SCRIPT_NAME $VERSION"; return 0 ;;
      -h|--help)    show_help; return 0 ;;

      --)           shift; break ;;
      -[csvqVh]?*)  set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;

      -*)           die 22 "Unknown option ${1@Q}." "Run: $SCRIPT_NAME --help" ;;
      *)            die 22 "Unexpected argument ${1@Q}" ;;
    esac
    shift
  done

  # Fetch and validate IP
  GATEWAY_IP=$(get_internet_ip) || die 23 'Failed to retrieve valid IP'

  # Cache to file if root
  if ((EUID == 0)); then
    echo "$GATEWAY_IP" > "$GATEWAY_IP_FILE"
    chmod 666 "$GATEWAY_IP_FILE"
  fi

  echo "$GATEWAY_IP"

  if ((call_url)); then
    internetip_call_url "$GATEWAY_IP"
  fi
}

main "$@"
#fin
